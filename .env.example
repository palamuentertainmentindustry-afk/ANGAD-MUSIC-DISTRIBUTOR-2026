# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin Authentication (optional; if unset, first-run admin setup form claims credentials in SQLite)
ADMIN_EMAIL=
ADMIN_PASSCODE=

# Session signing secret (optional; falls back to secure random key in memory)
SESSION_SECRET=

# Optional 32+ char key for AES-256-GCM encryption of stored KYC Aadhaar/PAN numbers
KYC_ENCRYPTION_KEY=
